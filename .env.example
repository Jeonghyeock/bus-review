# 네이버 클라우드 플랫폼 Maps (Dynamic Map) — 클라이언트에서 사용
NEXT_PUBLIC_NCP_KEY_ID=

# Supabase — 신규 프로젝트는 PUBLISHABLE_KEY 사용 (구 프로젝트는 ANON_KEY, 둘 중 하나만)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 공공데이터포털 버스 API (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
SEOUL_BUS_API_KEY=
GYEONGGI_BUS_API_KEY=

# 실 API 붙이기 전에는 목업으로 동작 (true). 실 API 준비되면 false.
BUS_USE_MOCK=true
