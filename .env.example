# 네이버 클라우드 플랫폼 Maps — ncpKeyId (없으면 지도 자리에 안내 표시)
NEXT_PUBLIC_NCP_KEY_ID=

# Supabase (리뷰·즐겨찾기·인증). 신규 프로젝트는 PUBLISHABLE_KEY, 구 프로젝트는 ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 공공데이터포털(data.go.kr) 경기버스(GBIS) Decoding 인증키 — 서버 전용
GYEONGGI_BUS_API_KEY=

# true(기본): 실 API 없이 목업으로 동작 / false: 실제 GBIS 데이터 사용
BUS_USE_MOCK=true
